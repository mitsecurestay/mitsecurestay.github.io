<style>
  :root {
    --ink: #12110F; --ink-light: #5A5751; --bg: #F7F6F3; --surface: #FFFFFF; --border: #E2DFD8;
    --accent: #1B4FD8; --accent-soft: #EEF2FC; --green: #1A7A4A; --green-soft: #EAF4EE;
    --amber: #C48A00; --amber-soft: #FBF3E1; --pill-radius: 6px; --card-radius: 10px;
    --shadow: 0 1px 4px rgba(0,0,0,.08); --font-head: 'Georgia', serif;
    --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { font-size: 16px; scroll-behavior: smooth; }
  body { font-family: var(--font-body); background: var(--bg); color: var(--ink); min-height: 100vh; }
  a { color: var(--accent); }
  .page-wrap { max-width: 720px; margin: 0 auto; padding: 0 16px 64px; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: var(--ink-light); text-decoration: none; }
  .back-link:hover { color: var(--accent); }
  .top-row { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; margin: 20px 0; }
  .top-row .back-link { justify-self: start; }
  .top-logo { height: 36px; width: auto; display: block; justify-self: center; }
  .page-header { margin-bottom: 24px; }
  .page-header h1 { font-family: var(--font-head); font-size: clamp(26px, 5vw, 34px); font-weight: 700; }
  .page-header p { color: var(--ink-light); font-size: 14px; margin-top: 8px; line-height: 1.5; }
  .criteria-item { background: var(--surface); border: 1px solid var(--border); border-radius: var(--card-radius);
                    padding: 16px 18px; margin-bottom: 12px; display: flex; gap: 14px; align-items: flex-start; }
  .criteria-item .num { font-family: var(--font-head); font-size: 18px; font-weight: 700; color: var(--accent); flex-shrink: 0; width: 22px; }
  .criteria-item h2 { font-size: 15px; font-weight: 700; margin-bottom: 6px; }
  .criteria-item ul { padding-left: 18px; }
  .criteria-item li { font-size: 14px; line-height: 1.6; color: var(--ink-light); margin-bottom: 2px; }
  .note-card { background: var(--accent-soft); border: 1px solid var(--border); border-radius: var(--card-radius);
               padding: 16px 18px; margin: 20px 0; font-size: 13.5px; line-height: 1.6; }
  .note-card strong { display: block; margin-bottom: 4px; font-size: 14px; }
  .section { margin: 28px 0; }
  .section h2 { font-family: var(--font-head); font-size: 18px; font-weight: 700; margin-bottom: 10px; }
  .section p { font-size: 14px; line-height: 1.65; color: var(--ink); }
  .site-footer { margin-top: 32px; padding-top: 18px; border-top: 1px solid var(--border); text-align: center; font-size: 12px; color: var(--ink-light); }
  .site-footer p { margin-top: 4px; }
  .site-footer a { color: var(--ink-light); }
  .site-footer a:hover { color: var(--accent); }
  .footer-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 14px; margin-bottom: 8px; font-size: 12.5px; }
</style>
</head>
